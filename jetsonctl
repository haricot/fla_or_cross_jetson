host_guard_cleanup() {
  local rc=${1:-0}
  if [[ -n "${HOST_GUARD_WATCHER_PID:-}" ]] && kill -0 "$HOST_GUARD_WATCHER_PID" 2>/dev/null; then
    sudo kill "$HOST_GUARD_WATCHER_PID" 2>/dev/null || kill "$HOST_GUARD_WATCHER_PID" 2>/dev/null || true
    wait "$HOST_GUARD_WATCHER_PID" 2>/dev/null || true
  fi
  if (( rc != 0 )) && [[ -n "${HOST_GUARD_RUN_DIR:-}" ]]; then
    echo "Flash backend failed (rc=$rc); collecting host diagnosis."
    "$ROOT/flash/diagnose.sh" --timeout 5 --no-wait > "$HOST_GUARD_RUN_DIR/diagnose.txt" 2>&1 || true
    echo "Diagnostic: $HOST_GUARD_RUN_DIR/diagnose.txt"
  fi
  if [[ "${HOST_NFS_GUARD_ACTIVE:-0}" == 1 && -n "${HOST_GUARD_STATE_FILE:-}" ]]; then
    sudo "$ROOT/host/nfs-guard.sh" \
      --state "$HOST_GUARD_STATE_FILE" \
      --l4t-dir "$VOLUME/downloads/Linux_for_Tegra" restore >/dev/null 2>&1 || true
    HOST_NFS_GUARD_ACTIVE=0
  fi
  if [[ -n "${HOST_GUARD_STATE_FILE:-}" && -r "$HOST_GUARD_STATE_FILE" ]]; then
    platform_sudo "$ROOT/host/usb-guard.sh" --state "$HOST_GUARD_STATE_FILE" restore >/dev/null 2>&1 || true
  fi
  if [[ -n "${HOST_GUARD_SUDO_PID:-}" ]] && kill -0 "$HOST_GUARD_SUDO_PID" 2>/dev/null; then
    kill "$HOST_GUARD_SUDO_PID" 2>/dev/null || true
    wait "$HOST_GUARD_SUDO_PID" 2>/dev/null || true
  fi
}

host_guard_signal_exit() {
  trap - EXIT INT TERM HUP
  host_guard_cleanup 130
  exit 130
}

auto_force_recovery_if_possible() {
  if "$ROOT/host/usb-discover.sh" recovery-sysfs >/dev/null 2>&1; then
    return 0
  fi

  case "${AUTO_FORCE_RECOVERY:-1}" in
    1|true|yes) ;;
    *)
      echo 'Automatic Force Recovery: DISABLED; waiting for manual APX/RCM.'
      return 1
      ;;
  esac

  if ! "$ROOT/host/usb-discover.sh" l4t-sysfs >/dev/null 2>&1; then
    return 1
  fi

  echo 'L4T USB gadget detected; attempting software Force Recovery before manual fallback.'
  platform_sudo "$ROOT/host/usb-guard.sh" \
    --state "$HOST_GUARD_STATE_FILE" fix-l4t-iface || true

  local recovery_rc=0
  if "$ROOT/host/enter-recovery.sh"; then
    return 0
  else
    recovery_rc=$?
  fi

  echo "Automatic Force Recovery did not reach APX/RCM (rc=${recovery_rc})." >&2
  echo 'Manual fallback remains available: enter Force Recovery physically.' >&2
  return "$recovery_rc"
}

with_host_flash_guard() {
  local mode=$1; shift
  need sudo
  need ip
  need udevadm
  need sysctl
  sudo -v
  HOST_GUARD_SUDO_PID=""
  (
    while true; do
      sudo -n -v >/dev/null 2>&1 || exit 0
      sleep 60
    done
  ) &
  HOST_GUARD_SUDO_PID=$!

  local stamp
  stamp=$(date +%Y%m%d-%H%M%S)
  HOST_GUARD_RUN_DIR="$VOLUME/logs/flash/${stamp}-$$"
  HOST_GUARD_STATE_FILE="$HOST_GUARD_RUN_DIR/host-state.tsv"
  HOST_GUARD_WATCHER_PID=""
  HOST_NFS_GUARD_ACTIVE=0
  mkdir -p "$HOST_GUARD_RUN_DIR"
  touch "$HOST_GUARD_STATE_FILE"

  echo "=== SMART HOST FLASH GUARD ==="
  echo "log_dir=$HOST_GUARD_RUN_DIR"
  trap 'rc=$?; host_guard_cleanup "$rc"' EXIT
  trap 'host_guard_signal_exit' INT TERM HUP
  platform_sudo "$ROOT/host/usb-guard.sh" --state "$HOST_GUARD_STATE_FILE" begin
  sudo "$ROOT/host/loop-guard.sh"
  local recovery_rc=0
  if auto_force_recovery_if_possible; then
    recovery_rc=0
  else
    recovery_rc=$?
  fi

  if [[ "$mode" == recovery && "$recovery_rc" -ne 0 && "${RECOVERY_MANUAL_FALLBACK_WAIT:-0}" != 1 ]]; then
    trap - EXIT INT TERM HUP
    host_guard_cleanup "$recovery_rc"
    HOST_GUARD_WATCHER_PID=""
    HOST_GUARD_STATE_FILE=""
    HOST_GUARD_SUDO_PID=""
    return "$recovery_rc"
  fi

  platform_sudo "$ROOT/host/usb-guard.sh" --state "$HOST_GUARD_STATE_FILE" --timeout "${HOST_FLASH_IFACE_TIMEOUT:-1800}" wait-recovery

  if [[ "$mode" == flash ]]; then
    echo "=== SMART HOST NFS GUARD ==="
    # Mark active before begin so the EXIT trap restores partial NFS state even
    # if a late RPC/mountd gate fails during begin itself.
    HOST_NFS_GUARD_ACTIVE=1
    sudo "$ROOT/host/nfs-guard.sh" \
      --state "$HOST_GUARD_STATE_FILE" \
      --l4t-dir "$VOLUME/downloads/Linux_for_Tegra" begin
    HOST_FLASH_IFACE_INTERVAL="${HOST_FLASH_IFACE_INTERVAL:-0.25}" \
    HOST_FLASH_KEEPALIVE_INTERVAL="${HOST_FLASH_KEEPALIVE_INTERVAL:-0.5}" \
    sudo -E "$ROOT/flash/network-watch.sh" \
      --state "$HOST_GUARD_STATE_FILE" \
      --timeout "${HOST_FLASH_IFACE_TIMEOUT:-1800}" \
      --ready-file "$HOST_GUARD_RUN_DIR/network-ready" \
      > "$HOST_GUARD_RUN_DIR/network-watch.log" 2>&1 &
    HOST_GUARD_WATCHER_PID=$!
    echo "network_watcher_log=$HOST_GUARD_RUN_DIR/network-watch.log"
  fi

  local rc=0
  set +e
  HOST_FLASH_WATCH_EXTERNAL=1 "$@"
  rc=$?
  set -e
  trap - EXIT INT TERM HUP
  host_guard_cleanup "$rc"
  HOST_GUARD_WATCHER_PID=""
  HOST_GUARD_STATE_FILE=""
  HOST_GUARD_SUDO_PID=""

  if [[ "$mode" == flash && "$rc" -eq 0 ]]; then
    case "${POST_FLASH_USB_GATE:-1}" in
      1|true|yes)
        echo "=== POST-FLASH L4T USB GATE ==="
        if ! platform_sudo "$ROOT/host/post-flash-network.sh" --timeout "${POST_FLASH_USB_TIMEOUT:-120}"; then
          echo "Post-flash USB management gate: WARN (flash itself succeeded)." >&2
        fi
        ;;
    esac
  fi
  return "$rc"
}

