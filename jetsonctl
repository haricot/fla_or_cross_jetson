    echo "$label: REUSE $dest"
    return 0
  fi
  local part="${dest}.part"
  echo "$label: téléchargement direct NVIDIA"
  echo "  $url"
  if ! curl -fL --retry 5 --retry-delay 2 --retry-all-errors --continue-at - -o "$part" "$url"; then
