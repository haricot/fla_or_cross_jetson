  MISTRALRS_REPO=...         fork éventuel
  MISTRALRS_REF=...          branche, tag ou SHA
  MISTRALRS_SOURCE_DIR=...   checkout local optionnel
  JETSON_SYSROOT=...         sysroot target (défaut: $VOLUME/downloads/Linux_for_Tegra/rootfs)
