flash_cmd() {
  local sub=${1:-doctor}; shift || true
  case "$sub" in
    image) build_sdkmanager_image ;;
    image-status) sdkmanager_image_state ;;
    doctor)
      "$ROOT/flash/host-preflight.sh"
      local runtime_state
      runtime_state=$(sdkmanager_image_state)
      echo "Flash runtime image: $runtime_state"
      if [[ "$runtime_state" == READY ]]; then
        VOLUME="$VOLUME" docker compose -f "$ROOT/flash/compose.yaml" run --rm --user 0:0 sdkm doctor
      else
        echo 'Container doctor skipped; flash runtime image is not READY.'
      fi
      ;;
    diagnose) VOLUME="$VOLUME" "$ROOT/flash/diagnose.sh" "$@" ;;
    enter-recovery)
      local recovery_ssh_host="${RECOVERY_SSH_HOST:-192.168.55.1}"
      local recovery_ssh_user="${RECOVERY_SSH_USER:-jetson}"
      local recovery_ssh_identity="${RECOVERY_SSH_IDENTITY:-}"
      local recovery_auto_timeout="${RECOVERY_AUTO_TIMEOUT:-90}"
      local recovery_manual_wait=0

      while (($#)); do
        case "$1" in
          --recovery-ssh-host|--host)
            [[ $# -ge 2 ]] || { echo "$1 demande HOST" >&2; exit 2; }
            recovery_ssh_host=$2; shift 2 ;;
          --recovery-ssh-user|--user)
            [[ $# -ge 2 ]] || { echo "$1 demande USER" >&2; exit 2; }
            recovery_ssh_user=$2; shift 2 ;;
          --recovery-ssh-key|--identity)
            [[ $# -ge 2 ]] || { echo "$1 demande PATH" >&2; exit 2; }
            recovery_ssh_identity=$2; shift 2 ;;
          --timeout)
            [[ $# -ge 2 ]] || { echo "--timeout demande SEC" >&2; exit 2; }
            recovery_auto_timeout=$2; shift 2 ;;
          --wait-manual)
            recovery_manual_wait=1; shift ;;
          -h|--help)
            cat <<'EOF_RECOVERY'
usage: ./jetsonctl flash enter-recovery [options]

Options:
  --recovery-ssh-host HOST | --host HOST
  --recovery-ssh-user USER | --user USER
  --recovery-ssh-key PATH  | --identity PATH
  --timeout SEC
  --wait-manual   after automatic failure, keep waiting for manual APX/RCM
EOF_RECOVERY
            return 0 ;;
          *) echo "option enter-recovery inconnue: $1" >&2; exit 2 ;;
        esac
      done

      RECOVERY_SSH_HOST="$recovery_ssh_host" \
      RECOVERY_SSH_USER="$recovery_ssh_user" \
      RECOVERY_SSH_IDENTITY="$recovery_ssh_identity" \
      RECOVERY_AUTO_TIMEOUT="$recovery_auto_timeout" \
      RECOVERY_MANUAL_FALLBACK_WAIT="$recovery_manual_wait" \
      AUTO_FORCE_RECOVERY=1 \
        with_host_flash_guard recovery true
      ;;
    plan) compose_flash plan "$@" ;;
    download) flash_download "$@" ;;
    prepare|validate-rootfs|create-user|mark-dirty)
      compose_flash "$sub" "$@" ;;
    generate-images)
      with_host_flash_guard generate compose_flash generate-images "$@"
      ;;
    flash-only)
      with_host_flash_guard flash compose_flash flash-only "$@"
      ;;
    nvme)
      export FLASH_TARGET=nvme
      if [[ "${1:-}" == "--reuse-images" ]]; then with_host_flash_guard flash compose_flash flash-only; else with_host_flash_guard flash compose_flash flash; fi
      ;;
    internal)
      export FLASH_TARGET=internal
      if [[ "${1:-}" == "--reuse-images" ]]; then with_host_flash_guard flash compose_flash flash-only; else with_host_flash_guard flash compose_flash flash; fi
      ;;
    shell) compose_flash shell ;;
    *) echo "flash subcommand inconnu: $sub" >&2; exit 2 ;;
  esac
}

case "${1:-help}" in
  profile)
    echo "PROFILE=$PROFILE"
    echo "JETSON_PLATFORM=${PLATFORM_NAME:-${JETSON_PLATFORM:-unknown}}"
    echo "VOLUME=$VOLUME"
    echo "CACHE_ROOT=$CACHE_ROOT"
    echo "CARGO_CACHE_DIR=$CARGO_CACHE_DIR"
    echo "MISTRALRS_TARGET_DIR=$MISTRALRS_TARGET_DIR"
    echo "BUILDKIT_CACHE_DIR=$BUILDKIT_CACHE_DIR"
    env | grep -E '^(PLATFORM_NAME|PLATFORM_FAMILY|PLATFORM_MODEL|PLATFORM_HARDWARE_TESTED|PROFILE_NAME|JETPACK|L4T|BOARD|SOC|RECOVERY_USB_PRODUCTS|FLASH_LAYOUT|CUDA_VERSION|CUDA_COMPUTE_CAP|CUDA_CROSS_PLATFORM|CUDA_CROSS_REPO|CROSS_IMAGE|MISTRALRS_REPO|MISTRALRS_REF|MISTRALRS_FEATURES|SDK_MANAGER_BOOTSTRAP_IMAGE|SDK_MANAGER_APT_DISTRO|SDK_MANAGER_APT_VERSION_PREFIX|SDK_MANAGER_IMAGE|DOWNLOAD_PROVIDER|L4T_DIRECT_BASE_URL|FLASH_TARGET|FLASH_ROOTDEV|FLASH_ERASE_ALL|EXTERNAL_DEVICE|NATIVE_CUDA_COMPAT_PACKAGE|NATIVE_CUDA_COMPAT_DIR)=' | sort
    ;;
  platform) shift; platform_cmd "$@" ;;
  cache)
    case "${2:-status}" in
      status|paths) cache_status ;;
