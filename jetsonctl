#!/usr/bin/env bash
set -Eeuo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$ROOT/lib/platform.sh"
source "$ROOT/lib/secrets.sh"

# fix14: --platform is a global selector and may appear before or after the
# subcommand, e.g. `jetsonctl --platform orin-nx cross cargo ...` or
# `jetsonctl cross cargo --platform orin-nx ...`.
PLATFORM_CLI=""
_platform_args=()
while (($#)); do
  case "$1" in
    --platform)
      [[ $# -ge 2 ]] || { echo '--platform demande NAME' >&2; exit 2; }
      PLATFORM_CLI=$2
      shift 2
      ;;
    *) _platform_args+=("$1"); shift ;;
  esac
done
set -- "${_platform_args[@]}"
unset _platform_args

if [[ "${1:-}" == "headless-flash" ]]; then
  shift
  [[ -n "$PLATFORM_CLI" ]] && export JETSON_PLATFORM="$PLATFORM_CLI"
  exec "$ROOT/flash/headless.sh" "$@"
fi

platform_load "$ROOT" "$PLATFORM_CLI"
VOLUME=${VOLUME:-$HOME/.cache/fla_or_cross_jetson/$PROFILE_NAME}
CACHE_ROOT=${CACHE_ROOT:-$VOLUME/cache}
CARGO_CACHE_DIR=${CARGO_CACHE_DIR:-$CACHE_ROOT/cargo-home}
CARGO_TARGET_ROOT=${CARGO_TARGET_ROOT:-$CACHE_ROOT/cargo-target}
BUILDKIT_CACHE_DIR=${BUILDKIT_CACHE_DIR:-$CACHE_ROOT/buildkit}
MISTRALRS_TARGET_DIR=${MISTRALRS_TARGET_DIR:-$CARGO_TARGET_ROOT/mistralrs-$PROFILE_NAME}
mkdir -p \
  "$VOLUME"/{downloads,tmp,.nvsdkm,sources,dist,custom,secrets} \
  "$VOLUME"/sdkmanager/{downloads,catalog,response-files,manifests} \
  "$VOLUME"/{state,logs/flash} \
  "$CARGO_CACHE_DIR" \
  "$CARGO_TARGET_ROOT" \
  "$BUILDKIT_CACHE_DIR" \
  "$MISTRALRS_TARGET_DIR"

need() { command -v "$1" >/dev/null || { echo "$1 est requis" >&2; exit 1; }; }

buildx_bake_cached() {
  local target="$1"
  local cache_key="$2"
  local cache_dir="$BUILDKIT_CACHE_DIR/$cache_key"
  local next_dir="$BUILDKIT_CACHE_DIR/${cache_key}.next"
  local old_dir="$BUILDKIT_CACHE_DIR/${cache_key}.old"
  local args=(-f "$ROOT/docker-bake.hcl" "$target")

  rm -rf "$next_dir" "$old_dir"
  mkdir -p "$next_dir"

  if [[ -f "$cache_dir/index.json" ]]; then
    args+=(--set "$target.cache-from=type=local,src=$cache_dir")
  fi
  args+=(--set "$target.cache-to=type=local,dest=$next_dir,mode=max")

  if ! docker buildx bake "${args[@]}"; then
    rm -rf "$next_dir"
    return 1
  fi

  if [[ -d "$cache_dir" ]]; then
    mv "$cache_dir" "$old_dir"
  fi
  mv "$next_dir" "$cache_dir"
  rm -rf "$old_dir"
}

cross_image_fingerprint() {
  local wrapper_hash
  wrapper_hash=$(sha256sum \
    "$ROOT/containers/cross.Dockerfile" \
    "$ROOT/gates/audit-cross-image.sh" \
    "$ROOT/gates/audit-jetson-link.sh" \
    | sha256sum | awk '{print $1}')
  # The cross image contains the generic AArch64/SBSA toolchain. sm87/sm110
  # selection happens at gate/build time and must not force an image rebuild.
  printf '%s' "${wrapper_hash}|${RUST_TOOLCHAIN}|${RUST_TARGET}|${CUDA_VERSION}|${CUDA_VERSION_FULL}|${CUDA_CROSS_PACKAGE}|${CUDA_CROSS_REPO}" \
    | sha256sum | awk '{print $1}'
}

cross_image_state() {
  need docker
  if ! docker image inspect "$CROSS_IMAGE" >/dev/null 2>&1; then
    printf 'ABSENT\n'
    return 0
  fi
  local want have
  want=$(cross_image_fingerprint)
  have=$(docker image inspect -f '{{ index .Config.Labels "org.haricot.fla.cross-wrapper-fingerprint" }}' "$CROSS_IMAGE" 2>/dev/null || true)
  if [[ -n "$have" && "$have" == "$want" ]]; then printf 'READY\n'; else printf 'STALE\n'; fi
}

build_cross_image() {
  need docker
  docker buildx version >/dev/null
  local fingerprint
  fingerprint=$(cross_image_fingerprint)
  echo "Cross image fingerprint: $fingerprint"
  RUST_TOOLCHAIN="$RUST_TOOLCHAIN" CUDA_VERSION="$CUDA_VERSION" CUDA_VERSION_FULL="$CUDA_VERSION_FULL" CUDA_CROSS_PACKAGE="$CUDA_CROSS_PACKAGE" \
  CUDA_CROSS_REPO="$CUDA_CROSS_REPO" CUDA_KEYRING_VERSION="$CUDA_KEYRING_VERSION" CROSS_IMAGE="$CROSS_IMAGE" \
  CROSS_IMAGE_FINGERPRINT="$fingerprint" \
    buildx_bake_cached cross cross
}

ensure_cross_image() {
  local state
  state=$(cross_image_state)
  case "$state" in
    READY) return 0 ;;
    ABSENT) echo 'Image cross absente: construction automatique.' ;;
    STALE) echo 'Image cross obsolète pour fix14/toolchain courant: reconstruction automatique.' ;;
    *) echo "État image cross inattendu: $state" >&2; exit 1 ;;
  esac
  build_cross_image
  [[ "$(cross_image_state)" == READY ]] || { echo 'Image cross non conforme après build.' >&2; exit 1; }
}

sdkmanager_image_fingerprint() {
  local wrapper_hash
  wrapper_hash=$(sha256sum \
    "$ROOT/containers/sdkmanager.Dockerfile" \
    "$ROOT/flash/entrypoint.sh" \
    "$ROOT/flash/compose.yaml" \
    | sha256sum | awk '{print $1}')
  printf '%s' "${wrapper_hash}|${SDK_MANAGER_BOOTSTRAP_IMAGE}|${SDK_MANAGER_APT_DISTRO}|${SDK_MANAGER_APT_VERSION_PREFIX}" \
    | sha256sum | awk '{print $1}'
}

sdkmanager_image_state() {
  need docker
  if ! docker image inspect "$SDK_MANAGER_IMAGE" >/dev/null 2>&1; then
    printf 'ABSENT\n'
    return 0
  fi
  local want have
  want=$(sdkmanager_image_fingerprint)
  have=$(docker image inspect -f '{{ index .Config.Labels "org.haricot.fla.sdkm-wrapper-fingerprint" }}' "$SDK_MANAGER_IMAGE" 2>/dev/null || true)
  if [[ -n "$have" && "$have" == "$want" ]]; then
    printf 'READY\n'
  else
    printf 'STALE\n'
  fi
}

build_sdkmanager_image() {
  need docker
  docker buildx version >/dev/null
  local fingerprint
  fingerprint=$(sdkmanager_image_fingerprint)
  echo "Bootstrap SDK Manager ${SDK_MANAGER_APT_VERSION_PREFIX} depuis le dépôt NVIDIA (${SDK_MANAGER_APT_DISTRO})."
  echo "SDK Manager wrapper fingerprint: ${fingerprint}"
  SDK_MANAGER_BOOTSTRAP_IMAGE="$SDK_MANAGER_BOOTSTRAP_IMAGE" \
  SDK_MANAGER_APT_DISTRO="$SDK_MANAGER_APT_DISTRO" \
  SDK_MANAGER_APT_VERSION_PREFIX="$SDK_MANAGER_APT_VERSION_PREFIX" \
  SDK_MANAGER_IMAGE="$SDK_MANAGER_IMAGE" \
  SDK_MANAGER_IMAGE_FINGERPRINT="$fingerprint" \
    buildx_bake_cached sdkmanager sdkmanager
}

ensure_sdkmanager_image() {
  local state
  state=$(sdkmanager_image_state)
  case "$state" in
    READY) return 0 ;;
    ABSENT) echo "Image SDK Manager absente: bootstrap automatique." ;;
    STALE) echo "Image SDK Manager obsolète par rapport au wrapper courant: reconstruction automatique." ;;
    *) echo "État SDK Manager inattendu: $state" >&2; exit 1 ;;
  esac
  build_sdkmanager_image
  state=$(sdkmanager_image_state)
  [[ "$state" == READY ]] || { echo "Image SDK Manager non conforme après rebuild: $state" >&2; exit 1; }
}

source_git_repo() {
  need git
  local repo=$1 ref=$2 src=$3
  [[ -n "$repo" && -n "$ref" && -n "$src" ]] || { echo 'source_git_repo: repo/ref/src requis' >&2; exit 2; }
  if [[ ! -d "$src/.git" ]]; then
    mkdir -p "$(dirname "$src")"
    git clone "$repo" "$src"
  fi
  git -C "$src" remote set-url origin "$repo"
  git -C "$src" fetch --prune --tags origin
  if git -C "$src" show-ref --verify --quiet "refs/remotes/origin/$ref"; then
    git -C "$src" checkout --detach "origin/$ref"
  elif git -C "$src" show-ref --verify --quiet "refs/tags/$ref"; then
    git -C "$src" checkout --detach "refs/tags/$ref"
  elif git -C "$src" rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
    git -C "$src" checkout --detach "$ref"
  else
    git -C "$src" fetch origin "$ref"
    git -C "$src" checkout --detach FETCH_HEAD
  fi
  printf '%s\n' "$src"
}

repo_slug() {
  local repo=$1 base
  base=${repo##*/}; base=${base%.git}
  base=$(printf '%s' "$base" | tr -cs 'A-Za-z0-9._-' '-')
  printf '%s\n' "${base:-source}"
}

source_mistralrs() {
  local src=${MISTRALRS_SOURCE_DIR:-$VOLUME/sources/mistral.rs}
  source_git_repo "$MISTRALRS_REPO" "$MISTRALRS_REF" "$src"
}

cross_sysroot_gate() {
  local sysroot=$1
  [[ -d "$sysroot/usr" && -r "$sysroot/etc/os-release" ]] || { echo "Jetson sysroot absent/incomplet: $sysroot" >&2; exit 1; }
  [[ -r "$sysroot/etc/nv_tegra_release" ]] || { echo "Jetson sysroot sans /etc/nv_tegra_release: $sysroot" >&2; exit 1; }
  grep -q '^# R39 ' "$sysroot/etc/nv_tegra_release" || { echo 'Jetson sysroot L4T inattendu (R39 requis)' >&2; exit 1; }
  [[ -d "$sysroot/usr/lib/aarch64-linux-gnu" ]] || { echo 'Jetson sysroot sans usr/lib/aarch64-linux-gnu' >&2; exit 1; }
  if [[ "${NATIVE_CUDA_ENABLE:-1}" == 1 ]]; then
    [[ -x "$sysroot${NATIVE_CUDA_ROOT:-/usr/local/cuda-13.3}/bin/nvcc" ]] || { echo 'Jetson sysroot sans native CUDA nvcc; lance ./jetsonctl native-sdk apply' >&2; exit 1; }
    [[ -d "$sysroot${NATIVE_CUDA_COMPAT_DIR:-/usr/local/cuda-13.3/compat_orin}" ]] || { echo 'Jetson sysroot sans compat_orin; lance ./jetsonctl native-sdk apply' >&2; exit 1; }
  fi
  echo "Jetson sysroot: PASS ($sysroot)"
}

cross_cargo() {
  local repo="" ref=master source_dir="" package="" bin="" features=""
  local manifest_path="" artifact_name="" profile=release locked=1 no_default=0
  while (($#)); do
    case "$1" in
      --repo) [[ $# -ge 2 ]] || { echo '--repo demande URL' >&2; exit 2; }; repo=$2; shift 2 ;;
      --ref) [[ $# -ge 2 ]] || { echo '--ref demande branche/tag/SHA' >&2; exit 2; }; ref=$2; shift 2 ;;
      --source-dir) [[ $# -ge 2 ]] || { echo '--source-dir demande PATH' >&2; exit 2; }; source_dir=$2; shift 2 ;;
      --package|-p) [[ $# -ge 2 ]] || { echo '--package demande NAME' >&2; exit 2; }; package=$2; shift 2 ;;
      --bin) [[ $# -ge 2 ]] || { echo '--bin demande NAME' >&2; exit 2; }; bin=$2; shift 2 ;;
      --features) [[ $# -ge 2 ]] || { echo '--features demande LIST' >&2; exit 2; }; features=$2; shift 2 ;;
      --manifest-path) [[ $# -ge 2 ]] || { echo '--manifest-path demande PATH' >&2; exit 2; }; manifest_path=$2; shift 2 ;;
      --artifact-name) [[ $# -ge 2 ]] || { echo '--artifact-name demande NAME' >&2; exit 2; }; artifact_name=$2; shift 2 ;;
      --no-default-features) no_default=1; shift ;;
      --no-locked) locked=0; shift ;;
      --locked) locked=1; shift ;;
      --debug) profile=debug; shift ;;
      --release) profile=release; shift ;;
      -h|--help)
        cat <<'EOF_CROSS_CARGO'
usage: ./jetsonctl cross cargo --repo URL --ref REF --bin BIN [options]

  --package NAME              Cargo package/workspace member
  --features LIST             Cargo features, e.g. 'cuda,flash-attn'
  --no-default-features
  --manifest-path PATH
  --source-dir PATH           checkout persistant explicite
  --artifact-name NAME        nom sous VOLUME/dist (défaut: --bin)
  --no-locked                 n'impose pas Cargo.lock
  --debug                     build debug (release par défaut)
EOF_CROSS_CARGO
        return 0 ;;
      *) echo "cross cargo: option inconnue $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$repo" ]] || { echo 'cross cargo: --repo requis' >&2; exit 2; }
  [[ -n "$bin" ]] || { echo 'cross cargo: --bin requis pour sélectionner/copier un artefact' >&2; exit 2; }
  [[ -n "$artifact_name" ]] || artifact_name=$bin
  [[ "$artifact_name" != */* ]] || { echo '--artifact-name ne doit pas contenir /' >&2; exit 2; }
  need docker

  ensure_cross_image

  local slug src sysroot
  slug=$(repo_slug "$repo")
  src=${source_dir:-$VOLUME/sources/$slug}
  src=$(source_git_repo "$repo" "$ref" "$src")
  sysroot=${JETSON_SYSROOT:-$VOLUME/downloads/Linux_for_Tegra/rootfs}
  cross_sysroot_gate "$sysroot"

  local build_key target_dir cuda_target rustflags bindgen pkg_libdir lib_path
  build_key=$(printf '%s\n' "$repo|$ref|$package|$bin|$features|$manifest_path|$profile|$no_default|$RUST_TARGET|$CUDA_COMPUTE_CAP" | sha256sum | awk '{print substr($1,1,16)}')
  target_dir=${CROSS_TARGET_DIR:-$CARGO_TARGET_ROOT/generic-$slug-$build_key}
  mkdir -p "$CARGO_CACHE_DIR" "$target_dir" "$VOLUME/dist"
  cuda_target=/usr/local/cuda/targets/sbsa-linux
  rustflags="-L native=/opt/jetson-sysroot/usr/lib/aarch64-linux-gnu -L native=/opt/jetson-sysroot/usr/lib/aarch64-linux-gnu/nvidia -L native=/opt/jetson-sysroot/lib/aarch64-linux-gnu -L native=${cuda_target}/lib -L native=${cuda_target}/lib/stubs -C link-arg=-Wl,-rpath-link,/opt/jetson-sysroot/usr/lib/aarch64-linux-gnu -C link-arg=-Wl,-rpath-link,/opt/jetson-sysroot/usr/lib/aarch64-linux-gnu/nvidia -C link-arg=-Wl,-rpath-link,${cuda_target}/lib -C link-arg=-Wl,-rpath-link,${cuda_target}/lib/stubs"
  bindgen="--target=aarch64-linux-gnu -I/usr/aarch64-linux-gnu/include -I/opt/jetson-sysroot/usr/include -I/opt/jetson-sysroot/usr/include/aarch64-linux-gnu -I${cuda_target}/include"
  pkg_libdir="/opt/jetson-sysroot/usr/lib/aarch64-linux-gnu/pkgconfig:/opt/jetson-sysroot/usr/lib/pkgconfig:/opt/jetson-sysroot/usr/share/pkgconfig"
  lib_path="${cuda_target}/lib:${cuda_target}/lib/stubs:/opt/jetson-sysroot/usr/lib/aarch64-linux-gnu:/opt/jetson-sysroot/usr/lib/aarch64-linux-gnu/nvidia:/opt/jetson-sysroot/lib/aarch64-linux-gnu:/usr/aarch64-linux-gnu/lib"

  local -a cargo=(cargo build --target "$RUST_TARGET")
  [[ "$profile" == release ]] && cargo+=(--release)
  (( locked == 1 )) && cargo+=(--locked)
  [[ -n "$manifest_path" ]] && cargo+=(--manifest-path "$manifest_path")
  [[ -n "$package" ]] && cargo+=(--package "$package")
  cargo+=(--bin "$bin")
  (( no_default == 1 )) && cargo+=(--no-default-features)
  [[ -n "$features" ]] && cargo+=(--features "$features")

  echo "=== GENERIC JETSON CROSS ==="
  echo "repo=$repo"
  echo "ref=$ref"
  echo "source=$src"
  echo "sysroot=$sysroot"
  echo "target=$RUST_TARGET sm_${CUDA_COMPUTE_CAP} CUDA=$CUDA_VERSION"
  echo "package=${package:--} bin=$bin features=${features:--}"

  docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -e CARGO_HOME=/work/cargo-home \
    -e RUSTUP_HOME=/opt/rustup \
    -e CARGO_TARGET_DIR=/work/target \
    -e CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    -e CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    -e CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    -e AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar \
    -e NVCC=/usr/local/cuda/bin/nvcc \
    -e NVCC_CCBIN=/usr/bin/aarch64-linux-gnu-g++ \
    -e CUDA_HOME=/usr/local/cuda \
    -e CUDA_PATH=/usr/local/cuda \
    -e CUDA_TARGET_ROOT="$cuda_target" \
    -e CUDA_SBSA_ROOT="$cuda_target" \
    -e CUDA_COMPUTE_CAP="$CUDA_COMPUTE_CAP" \
    -e CUDA_NVCC_FLAGS="-arch=sm_${CUDA_COMPUTE_CAP}" \
    -e CUDAARCHS="$CUDA_COMPUTE_CAP" \
    -e CMAKE_CUDA_ARCHITECTURES="$CUDA_COMPUTE_CAP" \
    -e CUDACXX=/usr/local/cuda/bin/nvcc \
    -e CUDAFORGE_THREADS="${CUDAFORGE_THREADS:-8}" \
    -e JETSON_SYSROOT=/opt/jetson-sysroot \
    -e PKG_CONFIG_ALLOW_CROSS=1 \
    -e PKG_CONFIG_SYSROOT_DIR=/opt/jetson-sysroot \
    -e PKG_CONFIG_LIBDIR="$pkg_libdir" \
    -e LIBRARY_PATH="$lib_path" \
    -e BINDGEN_EXTRA_CLANG_ARGS_aarch64_unknown_linux_gnu="$bindgen" \
    -e CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS="$rustflags" \
    -v "$src:/work/src" \
    -v "$CARGO_CACHE_DIR:/work/cargo-home" \
    -v "$target_dir:/work/target" \
    -v "$sysroot:/opt/jetson-sysroot:ro" \
    -w /work/src \
    "$CROSS_IMAGE" "${cargo[@]}"

  local profile_dir=$profile
  local built="$target_dir/$RUST_TARGET/$profile_dir/$bin"
  [[ -x "$built" ]] || { echo "binaire absent: $built" >&2; exit 1; }
  cp -f "$built" "$VOLUME/dist/$artifact_name"
  chmod 0755 "$VOLUME/dist/$artifact_name"
  "$ROOT/gates/audit-aarch64.sh" "$VOLUME/dist/$artifact_name"
  "$ROOT/gates/audit-jetson-link.sh" "$VOLUME/dist/$artifact_name" "$sysroot"
  echo "artifact: $VOLUME/dist/$artifact_name"
}

build_mistralrs() {
  cross_cargo \
    --repo "$MISTRALRS_REPO" \
    --ref "$MISTRALRS_REF" \
    --source-dir "${MISTRALRS_SOURCE_DIR:-$VOLUME/sources/mistral.rs}" \
    --package "$MISTRALRS_PACKAGE" \
    --bin "$MISTRALRS_BIN" \
    --features "$MISTRALRS_FEATURES" \
    --artifact-name "$MISTRALRS_BIN"
}

cross_deploy() {
  need ssh
  local artifact="" host=192.168.55.1 user=${DEFAULT_USER:-} identity="" remote_dir='.local/bin'
  while (($#)); do
    case "$1" in
      --artifact) [[ $# -ge 2 ]] || { echo '--artifact demande PATH' >&2; exit 2; }; artifact=$2; shift 2 ;;
      --host) [[ $# -ge 2 ]] || { echo '--host demande HOST' >&2; exit 2; }; host=$2; shift 2 ;;
      --user) [[ $# -ge 2 ]] || { echo '--user demande USER' >&2; exit 2; }; user=$2; shift 2 ;;
      --identity|-i) [[ $# -ge 2 ]] || { echo '--identity demande PATH' >&2; exit 2; }; identity=$2; shift 2 ;;
      --remote-dir) [[ $# -ge 2 ]] || { echo '--remote-dir demande PATH relatif au HOME' >&2; exit 2; }; remote_dir=$2; shift 2 ;;
      *) echo "cross deploy: option inconnue $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$artifact" && -r "$artifact" ]] || { echo 'cross deploy: --artifact lisible requis' >&2; exit 2; }
  [[ -n "$user" ]] || { echo 'cross deploy: --user requis (ou DEFAULT_USER)' >&2; exit 2; }
  [[ "$remote_dir" != /* && "$remote_dir" != *..* && "$remote_dir" =~ ^[A-Za-z0-9._/+:-]+$ ]] || { echo '--remote-dir doit rester relatif au HOME, sans .. ni métacaractère shell' >&2; exit 2; }
  local name=${artifact##*/}
  [[ "$name" =~ ^[A-Za-z0-9._+-]+$ ]] || { echo 'nom d artefact non sûr pour deploy' >&2; exit 2; }
  local -a ssh_opts=(-o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new)
  [[ -n "$identity" ]] && ssh_opts+=(-i "$identity")
  echo "Deploy $artifact -> ${user}@${host}:~/${remote_dir}/${name}"
  ssh "${ssh_opts[@]}" "$user@$host" "mkdir -p ~/${remote_dir} && umask 022 && cat > ~/${remote_dir}/${name} && chmod 0755 ~/${remote_dir}/${name}" < "$artifact"
  ssh "${ssh_opts[@]}" "$user@$host" "file ~/${remote_dir}/${name}; ls -l ~/${remote_dir}/${name}"
}


target_gate() {
  need ssh
  local host=192.168.55.1 user=${DEFAULT_USER:-} identity=""
  while (($#)); do
    case "$1" in
      --host) [[ $# -ge 2 ]] || { echo '--host demande HOST' >&2; exit 2; }; host=$2; shift 2 ;;
      --user) [[ $# -ge 2 ]] || { echo '--user demande USER' >&2; exit 2; }; user=$2; shift 2 ;;
      --identity|-i) [[ $# -ge 2 ]] || { echo '--identity demande PATH' >&2; exit 2; }; identity=$2; shift 2 ;;
      *) echo "target gate: option inconnue $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$user" ]] || { echo 'target gate: --user requis (ou DEFAULT_USER)' >&2; exit 2; }
  local cc=${CUDA_COMPUTE_CAP:?CUDA_COMPUTE_CAP absent} expected_major expected_minor
  if [[ "$cc" =~ ^[0-9]{2}$ ]]; then
    expected_major=${cc:0:1}; expected_minor=${cc:1:1}
  elif [[ "$cc" =~ ^[0-9]{3}$ ]]; then
    expected_major=${cc:0:2}; expected_minor=${cc:2:1}
  else
    echo "compute capability invalide: $cc" >&2; exit 2
  fi
  local cuda_root=${NATIVE_CUDA_ROOT:-/usr/local/cuda-13.3}
  local compat=${NATIVE_CUDA_COMPAT_DIR:-/usr/local/cuda-13.3/compat_orin}
  local -a opts=(-o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new)
  [[ -n "$identity" ]] && opts+=(-i "$identity")
  echo "Target gate -> ${user}@${host} platform=${PLATFORM_NAME:-unknown} sm_${cc}"
  local remote_prefix
  printf -v remote_prefix 'CUDA_ROOT=%q COMPAT=%q EXPECT_MAJOR=%q EXPECT_MINOR=%q EXPECT_ARCH=%q PLATFORM=%q' \
    "$cuda_root" "$compat" "$expected_major" "$expected_minor" "$cc" "${PLATFORM_NAME:-unknown}"
  ssh "${opts[@]}" "$user@$host" "$remote_prefix bash -s" <<'EOF_TARGET_GATE'
set -Eeuo pipefail

echo '=== TARGET PLATFORM ==='
[[ "$(uname -m)" == aarch64 ]]
uname -a
head -n 2 /etc/nv_tegra_release
findmnt /
echo "platform_profile=$PLATFORM expected_sm=$EXPECT_ARCH"

echo
echo '=== CUDA TOOLKIT ==='
test -x "$CUDA_ROOT/bin/nvcc"
"$CUDA_ROOT/bin/nvcc" --version
[[ -d "$COMPAT" ]]

echo
echo "=== CUDA RUNTIME SM${EXPECT_ARCH} ==="
cat > /tmp/fla_cuda_gate.cu <<'EOF_CUDA'
#include <cuda_runtime.h>
#include <cstdio>
#include <cstdlib>
int main(int argc, char **argv) {
    if (argc != 3) return 9;
    int expect_major = std::atoi(argv[1]);
    int expect_minor = std::atoi(argv[2]);
    int n = 0;
    cudaError_t e = cudaGetDeviceCount(&n);
    if (e != cudaSuccess || n < 1) {
        std::fprintf(stderr, "cudaGetDeviceCount failed: %s n=%d\n", cudaGetErrorString(e), n);
        return 2;
    }
    cudaDeviceProp p{};
    e = cudaGetDeviceProperties(&p, 0);
    if (e != cudaSuccess) return 3;
    std::printf("device=%s cc=%d.%d expected=%d.%d\n", p.name, p.major, p.minor, expect_major, expect_minor);
    return (p.major == expect_major && p.minor == expect_minor) ? 0 : 4;
}
EOF_CUDA
"$CUDA_ROOT/bin/nvcc" "-arch=sm_${EXPECT_ARCH}" /tmp/fla_cuda_gate.cu -o /tmp/fla_cuda_gate
