    esac
    ;;
  secrets)
    case "${2:-status}" in
      status) secrets_status ;;
      install) secrets_install ;;
      doctor) secrets_doctor ;;
      build-resolver) secrets_build_resolver ;;
      set-password) secrets_set_named JETSON_PASSWORD headless ;;
      set-wifi) secrets_set_named WIFI_PSK headless ;;
      set-github-token) secrets_set_named GITHUB_TOKEN cross ;;
      set-ghcr-token) secrets_set_named GHCR_TOKEN cross ;;
      password-file) secrets_password_file ;;
      wifi-encrypt) secrets_wifi_encrypt ;;
      *) echo "usage: jetsonctl secrets {status|install|doctor|build-resolver|set-password|set-wifi|set-github-token|set-ghcr-token|password-file|wifi-encrypt}" >&2; exit 2 ;;
    esac
    ;;
  native-sdk)
    case "${2:-status}" in
      status) compose_flash native-sdk-status ;;
      apply) compose_flash native-sdk-apply ;;
      *) echo "usage: jetsonctl native-sdk {status|apply}" >&2; exit 2 ;;
    esac
    ;;
  custom)
    case "${2:-show}" in
      init) custom_init ;;
      show) custom_show ;;
      status) custom_init >/dev/null; compose_flash custom-status ;;
      apply) custom_init >/dev/null; compose_flash custom-apply ;;
      dirty) compose_flash mark-dirty ;;
      *) echo "usage: jetsonctl custom {init|show|status|apply|dirty}" >&2; exit 2 ;;
    esac
    ;;
  build-image) [[ "${2:-cross}" == cross ]] && build_cross_image || { echo "usage: jetsonctl build-image cross" >&2; exit 2; } ;;
  cross-image-status) cross_image_state ;;
  gate) [[ "${2:-}" == cross ]] && audit_cross_image || { echo "usage: jetsonctl gate cross" >&2; exit 2; } ;;
  source) [[ "${2:-}" == mistralrs ]] && source_mistralrs || { echo "usage: jetsonctl source mistralrs" >&2; exit 2; } ;;
  build) [[ "${2:-}" == mistralrs ]] && build_mistralrs || { echo "usage: jetsonctl build mistralrs" >&2; exit 2; } ;;
  cross)
    case "${2:-}" in
      cargo) shift 2; cross_cargo "$@" ;;
      deploy) shift 2; cross_deploy "$@" ;;
      *) echo "usage: jetsonctl cross {cargo|deploy} ..." >&2; exit 2 ;;
    esac
    ;;
  target)
    case "${2:-}" in
      gate) shift 2; target_gate "$@" ;;
      *) echo "usage: jetsonctl target gate --host HOST --user USER [--identity KEY]" >&2; exit 2 ;;
    esac
    ;;
  host)
    shift
    [[ "${1:-}" == usb ]] || { echo "usage: jetsonctl host usb {status|fix|restore}" >&2; exit 2; }
    shift
    host_usb_cmd "$@"
    ;;
  flash) shift; flash_cmd "$@" ;;
  help|-h|--help)
    cat <<EOF
usage:
  ./jetsonctl platform list
  ./jetsonctl platform current
  ./jetsonctl platform show NAME
  ./jetsonctl --platform orin-nano-super profile
  ./jetsonctl profile
  ./jetsonctl cache status
  ./jetsonctl build-image cross
  ./jetsonctl gate cross
  ./jetsonctl source mistralrs
  ./jetsonctl build mistralrs
  ./jetsonctl cross cargo --platform PLATFORM --repo URL --ref REF --package PKG --bin BIN --features LIST
  ./jetsonctl cross deploy --artifact PATH --host HOST --user USER [--identity KEY]
  ./jetsonctl target gate --host HOST --user USER [--identity KEY]

  ./jetsonctl native-sdk status
  ./jetsonctl native-sdk apply

  ./jetsonctl custom init
  ./jetsonctl custom show
  ./jetsonctl custom status
  ./jetsonctl custom apply
  ./jetsonctl custom dirty

  ./jetsonctl secrets status
  ./jetsonctl secrets install
  ./jetsonctl secrets doctor
  ./jetsonctl secrets set-password
  ./jetsonctl secrets set-wifi
  ./jetsonctl secrets set-github-token
  ./jetsonctl secrets set-ghcr-token
  ./jetsonctl secrets build-resolver
  ./jetsonctl secrets wifi-encrypt      # legacy
  ./jetsonctl secrets password-file     # legacy

  ./jetsonctl flash image
  ./jetsonctl flash image-status
  ./jetsonctl host usb status
  ./jetsonctl host usb fix [--wait-recovery]
  ./jetsonctl host usb restore

  ./jetsonctl flash doctor
  ./jetsonctl flash diagnose [--fix]
  ./jetsonctl flash enter-recovery
  ./jetsonctl flash download [--provider direct|sdkmanager|local]
  ./jetsonctl flash download --provider sdkmanager --query
  ./jetsonctl flash download --provider sdkmanager [--select TITLE] [--deselect TITLE] [--additional-sdk TITLE]
  ./jetsonctl flash prepare [--reset]
  ./jetsonctl flash plan
