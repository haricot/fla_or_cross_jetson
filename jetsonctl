secrets_password_file() {
  local out="$VOLUME/secrets/default-password" pass="" confirm=""
  [[ -r /dev/tty ]] || { echo "TTY requis" >&2; exit 1; }
  read -rsp "Mot de passe Jetson à enregistrer: " pass < /dev/tty; printf '\n' > /dev/tty
  read -rsp "Confirme: " confirm < /dev/tty; printf '\n' > /dev/tty
  [[ -n "$pass" && "$pass" == "$confirm" ]] || { unset pass confirm; echo "Mot de passe vide ou confirmation différente." >&2; exit 1; }
  umask 077
  printf '%s\n' "$pass" > "$out"
  chmod 600 "$out"
  unset pass confirm
  echo "Mot de passe enregistré en mode 0600: $out (LEGACY)"
}

secrets_wifi_encrypt() {
  need openssl
  local out="$VOLUME/secrets/wifi-psk.enc" psk="" psk2="" encpass="" encpass2=""
  [[ -r /dev/tty ]] || { echo "TTY requis" >&2; exit 1; }
  read -rsp "PSK Wi-Fi à chiffrer: " psk < /dev/tty; printf '\n' > /dev/tty
  read -rsp "Confirme le PSK Wi-Fi: " psk2 < /dev/tty; printf '\n' > /dev/tty
  [[ -n "$psk" && "$psk" == "$psk2" ]] || { unset psk psk2; echo "PSK vide ou confirmation différente." >&2; exit 1; }
  read -rsp "Passphrase OpenSSL: " encpass < /dev/tty; printf '\n' > /dev/tty
  read -rsp "Confirme la passphrase OpenSSL: " encpass2 < /dev/tty; printf '\n' > /dev/tty
  [[ -n "$encpass" && "$encpass" == "$encpass2" ]] || { unset psk psk2 encpass encpass2; echo "Passphrase vide ou confirmation différente." >&2; exit 1; }
  mkdir -p "$VOLUME/secrets"
  umask 077
  printf '%s\n' "$psk" | openssl enc -aes-256-cbc -salt -pbkdf2 -pass fd:3 -out "$out" 3<<<"$encpass"
  chmod 600 "$out"
  unset psk psk2 encpass encpass2
  rm -f "$VOLUME/secrets/wifi-psk"
  echo "PSK Wi-Fi chiffré créé: $out (LEGACY)"
}

