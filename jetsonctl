platform_cmd() {
  local sub=${1:-current}; shift || true
  case "$sub" in
    list)
      printf '%-22s %-7s %-6s %-12s %s\n' PLATFORM FAMILY CUDA TESTED NVIDIA_BOARD
      local name path
      while IFS= read -r name; do
        path=$(platform_profile_path "$ROOT" "$name")
        env -i PATH="$PATH" HOME="${HOME:-/tmp}" bash -c '
          set -Eeuo pipefail
          source "$1"
          printf "%-22s %-7s sm%-4s %-12s %s\\n" "$PLATFORM_NAME" "$PLATFORM_FAMILY" "$CUDA_COMPUTE_CAP" "$PLATFORM_HARDWARE_TESTED" "$BOARD"
        ' _ "$path"
      done < <(platform_names "$ROOT")
      ;;
    current)
      platform_summary
      ;;
    show)
      local name=${1:-${PLATFORM_NAME:-}}
      [[ -n "$name" ]] || { echo 'usage: jetsonctl platform show NAME' >&2; exit 2; }
      local path
      path=$(platform_profile_path "$ROOT" "$name")
      [[ -r "$path" ]] || { echo "platform inconnue: $name" >&2; exit 2; }
      env -i PATH="$PATH" HOME="${HOME:-/tmp}" bash -c '
        set -Eeuo pipefail
        set -a
        source "$1"
        set +a
        env | grep -E "^(PLATFORM_|PROFILE_NAME|JETPACK|L4T|BOARD|SOC|RECOVERY_USB_PRODUCTS|L4T_GADGET_USB_PRODUCTS|SDKM_TARGET|FLASH_LAYOUT|FLASH_TARGET|FLASH_ROOTDEV|EXTERNAL_DEVICE|NVME_XML|QSPI_XML|FLASH_USE_QSPI_XML|CUDA_COMPUTE_CAP|NATIVE_CUDA_COMPAT_PACKAGE|NATIVE_CUDA_COMPAT_DIR|POST_FLASH_USB_GATE|AUTO_FORCE_RECOVERY)=" | sort
      ' _ "$path"
      ;;
    *) echo 'usage: jetsonctl platform {list|current|show NAME}' >&2; exit 2 ;;
  esac
}

