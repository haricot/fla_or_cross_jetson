variables principales:
  JETSON_PLATFORM=...        plateforme intégrée (orin-nano-super par défaut)
  --platform NAME            sélecteur global; accepté à n'importe quelle position
  PROFILE=...                profil .env avancé/personnalisé
  VOLUME=...                 données persistantes hors ZIP
  CACHE_ROOT=...              racine des caches explicites (défaut: $VOLUME/cache)
  CARGO_CACHE_DIR=...         Cargo registry/git (défaut: $CACHE_ROOT/cargo-home)
  CARGO_TARGET_ROOT=...       builds Cargo (défaut: $CACHE_ROOT/cargo-target)
