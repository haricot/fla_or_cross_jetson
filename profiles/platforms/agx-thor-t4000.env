PLATFORM_NAME=agx-thor-t4000
PLATFORM_FAMILY=thor
PLATFORM_MODEL='Jetson T4000 / AGX Thor Developer Kit 64GB'
PLATFORM_HARDWARE_TESTED=no
PLATFORM_DEFAULT_HOSTNAME=jetson-thor
PLATFORM_SUPPORTED_FLASH_TARGETS=nvme,internal
BOARD=${BOARD:-jetson-agx-thor-t4000}
SOC=${SOC:-t264}
RECOVERY_USB_PRODUCTS=${RECOVERY_USB_PRODUCTS:-7226}
L4T_GADGET_USB_PRODUCTS=${L4T_GADGET_USB_PRODUCTS-}
AUTO_FORCE_RECOVERY=${AUTO_FORCE_RECOVERY:-0}
POST_FLASH_USB_GATE=${POST_FLASH_USB_GATE:-0}
SDKM_TARGET=${SDKM_TARGET:-JETSON_AGX_THOR_TARGETS}
FLASH_LAYOUT=${FLASH_LAYOUT:-thor}
FLASH_TARGET=${FLASH_TARGET:-nvme}
EXTERNAL_DEVICE=${EXTERNAL_DEVICE:-nvme0n1}
FLASH_ROOTDEV=${FLASH_ROOTDEV:-internal}
NVME_XML=${NVME_XML:-tools/kernel_flash/flash_l4t_t264_nvme.xml}
QSPI_XML=${QSPI_XML:-}
FLASH_USE_QSPI_XML=${FLASH_USE_QSPI_XML:-0}
CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP:-110}
NATIVE_CUDA_COMPAT_PACKAGE=${NATIVE_CUDA_COMPAT_PACKAGE:-cuda-compat-13-3}
NATIVE_CUDA_COMPAT_DIR=${NATIVE_CUDA_COMPAT_DIR:-/usr/local/cuda-13.3/compat}
PLATFORM_MIN_STORAGE_GIB=${PLATFORM_MIN_STORAGE_GIB:-234}
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/jp721-common.env"
