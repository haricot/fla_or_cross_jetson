PLATFORM_NAME=orin-nano-super
PLATFORM_FAMILY=orin
PLATFORM_MODEL='Jetson Orin Nano Developer Kit / Nano module (Super config)'
PLATFORM_HARDWARE_TESTED=yes
PLATFORM_DEFAULT_HOSTNAME=jetson-orin
PLATFORM_SUPPORTED_FLASH_TARGETS=nvme,internal
BOARD=${BOARD:-jetson-orin-nano-devkit-super}
SOC=${SOC:-t234}
RECOVERY_USB_PRODUCTS=${RECOVERY_USB_PRODUCTS:-7523,7623}
L4T_GADGET_USB_PRODUCTS=${L4T_GADGET_USB_PRODUCTS-7020}
AUTO_FORCE_RECOVERY=${AUTO_FORCE_RECOVERY:-1}
POST_FLASH_USB_GATE=${POST_FLASH_USB_GATE:-1}
SDKM_TARGET=${SDKM_TARGET:-JETSON_ORIN_NANO_TARGETS}
FLASH_LAYOUT=${FLASH_LAYOUT:-orin-nx-nano}
FLASH_TARGET=${FLASH_TARGET:-nvme}
EXTERNAL_DEVICE=${EXTERNAL_DEVICE:-nvme0n1p1}
FLASH_ROOTDEV=${FLASH_ROOTDEV:-external}
NVME_XML=${NVME_XML:-tools/kernel_flash/flash_l4t_t234_nvme.xml}
QSPI_XML=${QSPI_XML:-bootloader/generic/cfg/flash_t234_qspi.xml}
FLASH_USE_QSPI_XML=${FLASH_USE_QSPI_XML:-1}
CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP:-87}
NATIVE_CUDA_COMPAT_PACKAGE=${NATIVE_CUDA_COMPAT_PACKAGE:-cuda-compat-orin-13-3}
NATIVE_CUDA_COMPAT_DIR=${NATIVE_CUDA_COMPAT_DIR:-/usr/local/cuda-13.3/compat_orin}
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/jp721-common.env"
