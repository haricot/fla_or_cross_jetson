# Shared JetPack 7.2.1 / L4T R39.2.1 defaults.
# Platform-specific files under profiles/platforms/ set BOARD/SOC/USB/flash/CUDA ABI.
PROFILE_NAME=${PROFILE_NAME:-jp721-${PLATFORM_NAME:-orin-nano-super}}
JETPACK=${JETPACK:-7.2.1}
L4T=${L4T:-39.2.1}
TARGET_UBUNTU=${TARGET_UBUNTU:-24.04}
RUST_TARGET=${RUST_TARGET:-aarch64-unknown-linux-gnu}
RUST_TOOLCHAIN=${RUST_TOOLCHAIN:-stable}
CUDA_VERSION=${CUDA_VERSION:-13.3}
CUDA_VERSION_FULL=${CUDA_VERSION_FULL:-13.3.0}
CUDA_CROSS_PLATFORM=${CUDA_CROSS_PLATFORM:-arm64-sbsa-jetson}
CUDA_CROSS_PACKAGE=${CUDA_CROSS_PACKAGE:-cuda-cross-sbsa-13-3}
CUDA_TARGET_ROOT=${CUDA_TARGET_ROOT:-/usr/local/cuda/targets/sbsa-linux}
CUDA_CROSS_REPO=${CUDA_CROSS_REPO:-https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/cross-linux-sbsa}
CUDA_KEYRING_VERSION=${CUDA_KEYRING_VERSION:-1.1-1}

# fix13/fix14: native CUDA SDK baked into the Jetson rootfs before image generation.
NATIVE_CUDA_ENABLE=${NATIVE_CUDA_ENABLE:-1}
NATIVE_CUDA_VERSION=${NATIVE_CUDA_VERSION:-13.3}
NATIVE_CUDA_REPO=${NATIVE_CUDA_REPO:-https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/sbsa}
NATIVE_CUDA_KEYRING_VERSION=${NATIVE_CUDA_KEYRING_VERSION:-1.1-1}
NATIVE_CUDA_TOOLKIT_PACKAGE=${NATIVE_CUDA_TOOLKIT_PACKAGE:-cuda-toolkit-13-3}
NATIVE_CUDA_ROOT=${NATIVE_CUDA_ROOT:-/usr/local/cuda-13.3}

CROSS_IMAGE=${CROSS_IMAGE:-fla-or-cross-jetson:jp721-cuda133}
MISTRALRS_REPO=${MISTRALRS_REPO:-https://github.com/EricLBuehler/mistral.rs}
MISTRALRS_REF=${MISTRALRS_REF:-master}
MISTRALRS_PACKAGE=${MISTRALRS_PACKAGE:-mistralrs-cli}
MISTRALRS_BIN=${MISTRALRS_BIN:-mistralrs}
MISTRALRS_FEATURES=${MISTRALRS_FEATURES:-'cuda,flash-attn'}

SDK_MANAGER_BOOTSTRAP_IMAGE=${SDK_MANAGER_BOOTSTRAP_IMAGE:-ubuntu:24.04}
SDK_MANAGER_APT_DISTRO=${SDK_MANAGER_APT_DISTRO:-ubuntu2404}
SDK_MANAGER_APT_VERSION_PREFIX=${SDK_MANAGER_APT_VERSION_PREFIX:-26.1}
# Keep the old 2.4.1 image intact. Override both vars for rollback.
SDK_MANAGER_IMAGE=${SDK_MANAGER_IMAGE:-fla-or-cross-jetson-sdkm:jp721-sdkm261}

FLASH_NETWORK=${FLASH_NETWORK:-usb0}
FLASH_ERASE_ALL=${FLASH_ERASE_ALL:-1}
L4T_BSP_FILE=${L4T_BSP_FILE:-Jetson_Linux_R39.2.1_aarch64.tbz2}
L4T_ROOTFS_FILE=${L4T_ROOTFS_FILE:-Tegra_Linux_Sample-Root-Filesystem_R39.2.1_aarch64.tbz2}
DOWNLOAD_PROVIDER=${DOWNLOAD_PROVIDER:-direct}
L4T_DIRECT_BASE_URL=${L4T_DIRECT_BASE_URL:-https://developer.download.nvidia.com/embedded/L4T/r39_Release_v2.1/release}
L4T_BSP_URL=${L4T_BSP_URL:-${L4T_DIRECT_BASE_URL}/${L4T_BSP_FILE}}
L4T_ROOTFS_URL=${L4T_ROOTFS_URL:-${L4T_DIRECT_BASE_URL}/${L4T_ROOTFS_FILE}}
SDKM_DOWNLOAD_DIR=${SDKM_DOWNLOAD_DIR:-/work/sdkmanager/downloads}
SDKM_CATALOG_DIR=${SDKM_CATALOG_DIR:-/work/sdkmanager/catalog}

DEFAULT_USER=${DEFAULT_USER:-}
DEFAULT_PASSWORD_FILE=${DEFAULT_PASSWORD_FILE-}
DEFAULT_HOSTNAME=${DEFAULT_HOSTNAME:-${PLATFORM_DEFAULT_HOSTNAME:-jetson}}
DEFAULT_AUTOLOGIN=${DEFAULT_AUTOLOGIN:-0}
DEFAULT_LOCALE=${DEFAULT_LOCALE:-fr_FR.UTF-8}
DEFAULT_KEYBOARD=${DEFAULT_KEYBOARD:-fr}
DEFAULT_SSH_AUTHORIZED_KEY_FILE=${DEFAULT_SSH_AUTHORIZED_KEY_FILE:-/work/secrets/authorized_key.pub}
DEFAULT_SSH_KEY_ONLY=${DEFAULT_SSH_KEY_ONLY:-0}
DEFAULT_SUDO_NOPASSWD=${DEFAULT_SUDO_NOPASSWD:-0}
DEFAULT_WIFI_SSID=${DEFAULT_WIFI_SSID:-}
DEFAULT_WIFI_PSK_FILE=${DEFAULT_WIFI_PSK_FILE-}
DEFAULT_WIFI_PSK_OPENSSL_FILE=${DEFAULT_WIFI_PSK_OPENSSL_FILE:-/work/secrets/wifi-psk.enc}

HOST_FLASH_IFACE=${HOST_FLASH_IFACE:-}
HOST_FLASH_IFACE_TIMEOUT=${HOST_FLASH_IFACE_TIMEOUT:-1800}
HOST_FLASH_IFACE_INTERVAL=${HOST_FLASH_IFACE_INTERVAL:-0.25}
HOST_FLASH_KEEPALIVE_INTERVAL=${HOST_FLASH_KEEPALIVE_INTERVAL:-0.5}
HOST_FLASH_WATCH_EXTERNAL=${HOST_FLASH_WATCH_EXTERNAL:-0}
POST_FLASH_USB_TIMEOUT=${POST_FLASH_USB_TIMEOUT:-120}
ALLOW_STALE_IMAGES=${ALLOW_STALE_IMAGES:-0}

RECOVERY_SSH_HOST=${RECOVERY_SSH_HOST:-192.168.55.1}
RECOVERY_SSH_USER=${RECOVERY_SSH_USER:-jetson}
RECOVERY_SSH_IDENTITY=${RECOVERY_SSH_IDENTITY:-}
RECOVERY_AUTO_TIMEOUT=${RECOVERY_AUTO_TIMEOUT:-90}
RECOVERY_SSH_CONNECT_TIMEOUT=${RECOVERY_SSH_CONNECT_TIMEOUT:-6}
